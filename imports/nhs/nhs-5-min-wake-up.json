          "exercise": "bw_squat",
          "forMode": "reps",
          "forValue": 8,
          "note": "8 to 10 slow squats down to the bed"
        },
        {
          "kind": "exercise",
          "id": "s15",
          "exercise": "bw_stretch_side",
          "forMode": "seconds",
          "forValue": 20,
