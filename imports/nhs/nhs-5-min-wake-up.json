      "kind": "block",
      "id": "b1",
      "name": "In bed",
      "repeat": 1,
      "note": "Each stretch is 3 to 4 deep, relaxing breaths",
      "steps": [
        {
          "kind": "exercise",
          "id": "s1",
          "exercise": "bw_stretch_overhead",
          "forMode": "seconds",
          "forValue": 20,
          "note": "3 to 4 deep breaths"
        },
        {
          "kind": "exercise",
          "id": "s2",
          "exercise": "bw_stretch_knee_to_chest",
          "forMode": "seconds",
          "forValue": 20,
          "note": "One knee, right"
        },
        {
          "kind": "exercise",
          "id": "s3",
          "exercise": "bw_stretch_knee_to_chest",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Left knee"
        },
        {
          "kind": "exercise",
          "id": "s4",
          "exercise": "bw_stretch_hamstring_lying",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Right leg"
        },
        {
          "kind": "exercise",
          "id": "s5",
          "exercise": "bw_stretch_hamstring_lying",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Left leg"
        },
        {
          "kind": "exercise",
          "id": "s6",
          "exercise": "bw_stretch_knee_to_chest",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Both knees"
        },
        {
          "kind": "exercise",
          "id": "s7",
          "exercise": "bw_knee_roll",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Roll to the right"
        },
        {
          "kind": "exercise",
          "id": "s8",
          "exercise": "bw_knee_roll",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Roll to the left"
        }
      ]
    },
    {
      "kind": "block",
      "id": "b2",
      "name": "Sitting and standing",
      "repeat": 1,
      "steps": [
        {
          "kind": "exercise",
          "id": "s9",
          "exercise": "bw_trunk_rotation",
          "forMode": "reps",
          "forValue": 8,
          "note": "6 to 8 each side"
        },
        {
          "kind": "exercise",
          "id": "s10",
          "exercise": "bw_stretch_chest",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Hands on hips, chest up and out"
        },
        {
          "kind": "exercise",
          "id": "s11",
          "exercise": "bw_stretch_upper_back",
          "forMode": "seconds",
          "forValue": 20
        },
        {
          "kind": "exercise",
          "id": "s12",
          "exercise": "bw_stretch_hamstring_seated",
          "forMode": "seconds",
          "forValue": 20
        },
        {
          "kind": "exercise",
          "id": "s13",
          "exercise": "bw_march",
          "forMode": "seconds",
          "forValue": 30,
