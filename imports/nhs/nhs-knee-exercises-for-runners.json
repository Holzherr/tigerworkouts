{
  "id": "nhs-knee-exercises-for-runners",
  "title": "Knee exercises for runners",
  "creator": "NHS",
  "description": "NHS knee-strengthening routine for runners: wall squats, seated thigh contractions, hamstring stretches with the thigh tensed, squats and lunges. It can be a warm-up, a cool-down or a standalone session and is not for anyone with an existing knee injury. The live page gives no counts for wall squats and squats, so the 3 sets of 10 from the 2022 version are used.",
  "source": {
    "title": "Knee exercises for runners",
    "url": "https://www.nhs.uk/live-well/exercise/knee-exercises-for-runners/",
    "author": "NHS",
    "kind": "article",
    "license": "Open Government Licence v3.0 (NHS)",
    "importedAt": "2026-09-06"
  },
  "tags": [
    "NHS",
    "Running",
    "Knees",
    "Strength",
    "No equipment",
    "Prehab"
  ],
  "level": "Easy",
  "items": [
    {
      "kind": "block",
      "id": "b1",
      "name": "Wall squats",
      "repeat": 3,
      "note": "3 sets of 10 (count from the 2022 page); an exercise ball behind the back smooths the movement",
      "steps": [
        {
          "kind": "exercise",
          "id": "s1",
          "exercise": "bw_wall_sit",
          "forMode": "reps",
          "forValue": 10
        },
        {
          "kind": "rest",
          "id": "r1",
          "seconds": 30
        }
      ]
    },
    {
      "kind": "block",
      "id": "b2",
      "name": "Thigh contraction",
      "repeat": 10,
      "note": "10 sets of 5 s each leg; ankle weight for more",
      "steps": [
        {
          "kind": "exercise",
          "id": "s2",
          "exercise": "bw_seated_leg_extension",
          "forMode": "seconds",
          "forValue": 5,
          "note": "Right leg, squeeze the thigh"
        },
        {
          "kind": "exercise",
          "id": "s3",
          "exercise": "bw_seated_leg_extension",
          "forMode": "seconds",
          "forValue": 5,
          "note": "Left leg"
        }
      ]
    },
    {
      "kind": "block",
      "id": "b3",
      "name": "Hamstring stretch with thigh contraction",
      "repeat": 3,
      "note": "3 sets of 15 s each leg",
      "steps": [
        {
          "kind": "exercise",
          "id": "s4",
          "exercise": "bw_stretch_hamstring_standing",
          "forMode": "seconds",
          "forValue": 15,
          "note": "Seated on the edge of a chair, left leg straight, tense the thigh"
        },
        {
          "kind": "exercise",
          "id": "s5",
          "exercise": "bw_stretch_hamstring_standing",
          "forMode": "seconds",
          "forValue": 15,
          "note": "Right leg"
        }
      ]
    },
    {
      "kind": "block",
      "id": "b4",
      "name": "Squats",
      "repeat": 3,
      "note": "3 sets of 10 (count from the 2022 page)",
      "steps": [
        {
          "kind": "exercise",
          "id": "s6",
          "exercise": "bw_squat",
          "forMode": "reps",
          "forValue": 10
        },
        {
          "kind": "rest",
          "id": "r2",
          "seconds": 30
        }
      ]
    },
    {
      "kind": "block",
      "id": "b5",
      "name": "Lunges",
      "repeat": 3,
      "note": "3 sets of 5 each leg",
      "steps": [
        {
          "kind": "exercise",
          "id": "s7",
          "exercise": "bw_lunge",
          "forMode": "reps",
          "forValue": 5,
          "note": "Split stance, right leg forward"
        },
        {
          "kind": "exercise",
          "id": "s8",
          "exercise": "bw_lunge",
          "forMode": "reps",
          "forValue": 5,
          "note": "Left leg forward"
        }
      ]
    }
  ]
}