          "id": "s8",
          "exercise": "bw_stretch_buttock",
          "forMode": "seconds",
          "forValue": 20,
          "note": "Right foot on the left thigh, 20 to 30 s"
        },
        {
          "kind": "exercise",
          "id": "s9",
