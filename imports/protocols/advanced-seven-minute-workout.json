{
  "id": "proto-advanced-seven-minute-workout",
  "title": "The Advanced 7-Minute Workout",
  "creator": "Chris Jordan (Johnson & Johnson Human Performance Institute)",
  "description": "The follow-up to the Scientific 7-Minute Workout, published by the New York Times in 2014. Eight compound moves with a pair of light dumbbells, most of them 60 seconds long, filling exactly seven minutes with no formal rest. Harder on balance and coordination than the original; go lighter on the dumbbells before going faster.",
  "source": {
    "title": "The Advanced 7-Minute Workout (NYT Well, 24 Oct 2014)",
    "url": "https://well.blogs.nytimes.com/2014/10/24/the-advanced-7-minute-workout/",
    "author": "Chris Jordan",
    "kind": "article",
    "license": "Published protocol; description in our own words",
    "importedAt": "2026-09-06"
  },
  "tags": [
    "Protocol",
    "HICT",
    "Dumbbell",
    "7 minutes"
  ],
  "level": "Hard",
  "items": [
    {
      "kind": "block",
      "id": "b1",
      "name": "Advanced 7-minute circuit",
      "mode": "rounds",
      "repeat": 1,
      "note": "No rest between exercises; the durations add up to 7:00.",
      "steps": [
        {
          "kind": "exercise",
          "id": "s1",
          "exercise": "bw_reverse_lunge_rotation",
          "forMode": "seconds",
          "forValue": 30,
          "note": "Alternating sides"
        },
        {
          "kind": "exercise",
          "id": "s2",
          "exercise": "bw_side_plank",
          "forMode": "seconds",
          "forValue": 30,
          "note": "Lateral pillar bridge, left side"
        },
        {
          "kind": "exercise",
          "id": "s3",
          "exercise": "db_pushup_row_burpee",
          "forMode": "seconds",
          "forValue": 60,
          "note": "Light dumbbells"
        },
        {
          "kind": "exercise",
          "id": "s4",
          "exercise": "bw_side_plank",
          "forMode": "seconds",
          "forValue": 30,
          "note": "Lateral pillar bridge, right side"
        },
        {
          "kind": "exercise",
          "id": "s5",
          "exercise": "db_single_leg_rdl_curl_press",
          "forMode": "seconds",
          "forValue": 60,
          "perSide": true,
          "note": "60 s per leg, left then right"
        },
        {
          "kind": "exercise",
          "id": "s6",
          "exercise": "bw_plank_arm_lift",
          "forMode": "seconds",
          "forValue": 30,
          "note": "Alternate arms"
        },
        {
          "kind": "exercise",
          "id": "s7",
          "exercise": "db_lateral_lunge_tricep_ext",
          "forMode": "seconds",
          "forValue": 60,
          "note": "Alternating sides"
        },
        {
          "kind": "exercise",
          "id": "s8",
          "exercise": "db_row",
          "forMode": "seconds",
          "forValue": 60,
          "note": "Alternating arms, light dumbbells"
        }
      ]
    }
  ]
