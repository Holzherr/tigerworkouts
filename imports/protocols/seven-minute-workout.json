{
  "id": "proto-seven-minute-workout",
  "title": "The Scientific 7-Minute Workout",
  "creator": "ACSM (Brett Klika & Chris Jordan)",
  "description": "Twelve bodyweight exercises done for 30 seconds each with 10 seconds between them, in an order that alternates upper body, lower body and core so one muscle group recovers while the next works. Published in ACSM's Health & Fitness Journal in 2013 and made famous by the New York Times, it needs only a wall and a chair. Work at a hard effort (8 out of 10); repeat the circuit two or three times if you have the time.",
  "source": {
    "title": "High-Intensity Circuit Training Using Body Weight: Maximum Results With Minimal Investment (ACSM's Health & Fitness Journal 17(3), May/June 2013)",
    "url": "https://journals.lww.com/acsm-healthfitness/fulltext/2013/05000/high_intensity_circuit_training_using_body_weight_.5.aspx",
    "author": "Brett Klika, Chris Jordan",
    "kind": "protocol",
    "license": "Published protocol; description in our own words",
    "importedAt": "2026-09-06"
  },
