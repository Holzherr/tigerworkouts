{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tigerworkouts-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Resolves the web app's "@/…" imports (src/features/runsheet/model.ts and friends).
  "tsconfig": "tsconfig.json",
  "observability": { "enabled": true },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "79961dac3c484d72aa0c39326ce83784" }],
  "vars": {
    // Nick and the Claude and App Store reviewers (review-claude@ / review-apple@tigerworkouts.com), until it opens.
    // Empty string = every TigerWorkouts account may connect.
    "ALLOWED_USER_IDS": "71ee1910-ef0a-471d-81bb-345ce7b9c2e3,b9e712ac-0107-4865-8290-5f645c99fa46,81991f45-472c-4631-95be-7e5564e3fea9",
    // Nick: may import a creator's workout with a credited `source` (create_workout / update_workout). specs/creator-imports.md.
    "ADMIN_USER_IDS": "71ee1910-ef0a-471d-81bb-345ce7b9c2e3",
    // Flip to "true" once https://mcp.tigerworkouts.com/callback is an allowed Supabase redirect URL.
    "GOOGLE_SIGNIN": "false",
    // "true" adds "Start now, no account needed" (Supabase anonymous sign-in). Needs Authentication →
    // Sign In / Providers → "Allow anonymous sign-ins" on in Supabase first. See specs/mcp.md.
    "ANONYMOUS_SIGNUP": "true",
    // Instagram bot (specs/instagram-bot.md). Imports belong to this account; it signs the bot in at /bot/connect.
    "INSTAGRAM_IMPORT_OWNER": "71ee1910-ef0a-471d-81bb-345ce7b9c2e3",
    "INSTAGRAM_USERNAME": "tigerworkouts",
    // The @tigerworkouts IG user id, once the account exists. Empty = the bot answers nobody.
    "INSTAGRAM_ACCOUNT_ID": "",
    "INSTAGRAM_GRAPH_BASE": "https://graph.facebook.com/v27.0",
    "INSTAGRAM_MODEL": "claude-haiku-5-5"
    // Secrets, never here: INSTAGRAM_ACCESS_TOKEN, INSTAGRAM_APP_SECRET, INSTAGRAM_VERIFY_TOKEN, ANTHROPIC_API_KEY (wrangler secret put).
  },
  "routes": [{ "pattern": "mcp.tigerworkouts.com", "custom_domain": true }]
}
